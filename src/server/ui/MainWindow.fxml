                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                              <Button layoutX="648.0" layoutY="349.0" mnemonicParsing="false" onAction="#handleCancelChanges" prefHeight="29.0" prefWidth="102.0" text="取消變更">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                              <Button layoutX="528.0" layoutY="387.0" mnemonicParsing="false" onAction="#handleReadSettingsFile" text="讀取配置文件">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                              <Button layoutX="648.0" layoutY="387.0" mnemonicParsing="false" onAction="#handleSaveAndApplySettings" prefHeight="29.0" prefWidth="102.0" text="儲存並應用">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
