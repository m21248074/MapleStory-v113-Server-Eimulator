                              <Label layoutX="14.0" layoutY="111.0" text="伺服器操作">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Pane layoutX="14.0" layoutY="134.0" prefHeight="370.0" prefWidth="878.0" style="-fx-border-width: 1; -fx-border-style: solid; -fx-border-color: gray; -fx-border-radius: 5;">
