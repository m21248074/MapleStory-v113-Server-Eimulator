<VBox prefHeight="570.0" prefWidth="910.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="server.ui.MainController">
  <children>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="596.0" prefWidth="910.0" VBox.vgrow="ALWAYS">
         <children>
            <TabPane prefHeight="547.0" prefWidth="910.0" tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab text="伺服器">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="910.0">
                           <children>
                              <Label layoutX="14.0" layoutY="14.0" text="伺服端操作">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <HBox layoutX="14.0" layoutY="38.0" prefHeight="64.0" prefWidth="886.0" spacing="10.0">
                                 <children>
                                    <Button fx:id="btnStartServer" mnemonicParsing="false" onAction="#handleStartServer" text="啟動伺服端" />
                                    <Button fx:id="btnStopServer" mnemonicParsing="false" onAction="#handleStopServer" text="關閉伺服端" />
