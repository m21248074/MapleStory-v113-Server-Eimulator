                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label layoutX="14.0" layoutY="354.0" text="IP" />
                              <Label layoutX="14.0" layoutY="386.0" text="帳號" />
                              <Label layoutX="14.0" layoutY="418.0" text="密碼" />
